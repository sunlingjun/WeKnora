+)
+
+// casAuthService 瀹炵幇 CAS 璁よ瘉鏈嶅姟
+type casAuthService struct {
+	casClient     *CASClient
+	userRepo      interfaces.UserRepository
+	userService   interfaces.UserService
+	tenantService interfaces.TenantService
+	config        *config.CASConfig
+}
+
+// NewCASAuthService 鍒涘缓 CAS 璁よ瘉鏈嶅姟
+func NewCASAuthService(
+	casClient *CASClient,
+	userRepo interfaces.UserRepository,
+	userService interfaces.UserService,
+	tenantService interfaces.TenantService,
+	cfg *config.Config,
+) interfaces.CASAuthService {
+	var casConfig *config.CASConfig
+	if cfg != nil {
+		casConfig = cfg.CAS
+	}
+	return &casAuthService{
+		casClient:     casClient,
+		userRepo:      userRepo,
+		userService:   userService,
+		tenantService: tenantService,
+		config:        casConfig,
+	}
+}
+
+// ValidateCASSession 楠岃瘉 CAS 浼氳瘽锛堥€氳繃 _cas_sid 鍜?_cas_uid锛?+// referer 鍙傛暟鐢ㄤ簬璁剧疆 Referer 澶达紝CAS API 闇€瑕佹澶磋繘琛屾牎楠?+func (s *casAuthService) ValidateCASSession(ctx context.Context, casSid, casUid string, referer string) (*types.CASUserInfo, error) {
+	if casSid == "" || casUid == "" {
+		return nil, fmt.Errorf("CAS session ID and UID are required")
+	}
+
+	// 璋冪敤 CAS 瀹㈡埛绔獙璇佷細璇?+	casUserInfo, err := s.casClient.ValidateSession(ctx, casSid, casUid, referer)
+	if err != nil {
+		return nil, fmt.Errorf("failed to validate CAS session: %w", err)
+	}
+
+	return casUserInfo, nil
+}
+
+// AutoBindUser 鑷姩缁戝畾鎴栧垱寤虹敤鎴凤紙CAS 鐢ㄦ埛淇℃伅 鈫?WeKnora 鐢ㄦ埛锛?+func (s *casAuthService) AutoBindUser(ctx context.Context, casUserInfo *types.CASUserInfo) (*types.User, error) {
+	// 鎻愬墠澹版槑锛岄伩鍏?goto 璺宠繃鍙橀噺澹版槑
+	var user *types.User
+	var err error
+	var hashedPassword []byte
+	var password string
+	var username string
+	var userEmail string
+	var existingUser *types.User
+	var createdTenant *types.Tenant
+	var tenantName string
+	var tenant *types.Tenant
+
+	// 姝ラ1锛氱敤鎴峰瓨鍦ㄦ€ф鏌ワ紙鎸変紭鍏堢骇鏌ユ壘锛?+	// 1.1 浼樺厛閫氳繃 cas_user_id 鏌ユ壘锛堟渶鍙潬锛孋AS 鐢ㄦ埛 ID 鍞竴锛?+	if casUserInfo.ID != "" {
+		user, err = s.userRepo.GetUserByCASUserID(ctx, casUserInfo.ID)
+		if err == nil && user != nil {
+			logger.Infof(ctx, "Found user by cas_user_id: %s", user.ID)
+			goto updateUser
+		}
+	}
+
+	// 1.2 濡傛灉鏈壘鍒帮紝閫氳繃 email 鏌ユ壘锛圕AS 閭涓?WeKnora 閭鍖归厤锛?+	if casUserInfo.Email != "" {
+		user, err = s.userRepo.GetUserByEmail(ctx, casUserInfo.Email)
+		if err == nil && user != nil {
+			logger.Infof(ctx, "Found user by email: %s", user.ID)
+			goto updateUser
+		}
+	}
+
+	// 姝ラ2锛氱敤鎴蜂笉瀛樺湪锛屽垱寤烘柊鐢ㄦ埛
+	logger.Infof(ctx, "User not found, creating new user for CAS user: %s", casUserInfo.ID)
+
+	// 2.1 鐢熸垚鐢ㄦ埛鍚嶏紙妫€鏌ュ敮涓€鎬э級
+	username = casUserInfo.LoginName
+	if username == "" {
+		// 濡傛灉 loginName 涓虹┖锛屼娇鐢?email 鍓嶇紑
+		if casUserInfo.Email != "" {
+			username = strings.Split(casUserInfo.Email, "@")[0]
+		} else {
+			// 濡傛灉 email 涔熶负绌猴紝浣跨敤 CAS ID
+			username = fmt.Sprintf("cas_%s", casUserInfo.ID)
+		}
+	}
+
+	// 2.2 妫€鏌ョ敤鎴峰悕鏄惁宸插瓨鍦紙澶勭悊鍐茬獊锛?+	existingUser, _ = s.userRepo.GetUserByUsername(ctx, username)
+	if existingUser != nil {
+		// 鐢ㄦ埛鍚嶅啿绐侊紝娣诲姞鍚庣紑
+		if len(casUserInfo.ID) >= 8 {
+			username = fmt.Sprintf("%s_%s", username, casUserInfo.ID[:8])
+		} else {
+			username = fmt.Sprintf("%s_%s", username, casUserInfo.ID)
+		}
+		logger.Warnf(ctx, "Username conflict, using: %s", username)
+	}
+
+	// 2.3 妫€鏌ラ偖绠辨槸鍚﹀凡瀛樺湪锛堢悊璁轰笂涓嶅簲璇ュ彂鐢燂紝鍥犱负宸茬粡閫氳繃 email 鏌ユ壘杩囷級
+	if casUserInfo.Email != "" {
+		existingUser, _ = s.userRepo.GetUserByEmail(ctx, casUserInfo.Email)
+		if existingUser != nil {
+			// 閭宸插瓨鍦紝璇存槑鍙兘鏄苟鍙戣姹傦紝杩斿洖鐜版湁鐢ㄦ埛
+			logger.Warnf(ctx, "Email already exists, returning existing user: %s", existingUser.ID)
+			return existingUser, nil
+		}
+	}
+
+	// 2.4 鐢熸垚瀵嗙爜骞跺搱甯岋紙CAS 鐢ㄦ埛涓嶉渶瑕佸瘑鐮侊紝浣嗘暟鎹簱瀛楁瑕佹眰闈炵┖锛?+	// 瀵嗙爜榛樿鍙栨墜鏈哄彿鍚庡洓浣嶏紝濡傛灉鎵嬫満鍙蜂负绌烘垨鏍煎紡涓嶅锛屼娇鐢ㄩ粯璁ゅ瘑鐮?+	password = "1234" // 榛樿瀵嗙爜
+	if casUserInfo.MobilePhone != "" {
+		// 鎻愬彇鎵嬫満鍙峰悗鍥涗綅锛堝鐞嗚劚鏁忔牸寮忥紝濡?"166****8186"锛?+		mobilePhone := casUserInfo.MobilePhone
+		// 绉婚櫎鎵€鏈夐潪鏁板瓧瀛楃
+		digits := ""
+		for _, r := range mobilePhone {
+			if r >= '0' && r <= '9' {
+				digits += string(r)
+			}
+		}
+		// 鍙栨渶鍚庡洓浣?+		if len(digits) >= 4 {
+			password = digits[len(digits)-4:]
+		}
+	}
+	hashedPassword, err = bcrypt.GenerateFromPassword([]byte(password), bcrypt.DefaultCost)
+	if err != nil {
+		return nil, fmt.Errorf("failed to hash password: %w", err)
+	}
+
+	// 2.5 鍏堝垱寤虹鎴凤紙鍥犱负鐢ㄦ埛闇€瑕佺鎴?ID锛屽閿害鏉熻姹傦級
+	// 娉ㄦ剰锛氳繖閲屽厛鍒涘缓绉熸埛锛岀劧鍚庡啀鍒涘缓鐢ㄦ埛骞剁粦瀹氱鎴?+	tenantName = fmt.Sprintf("%s鐨勫伐浣滅┖闂?, casUserInfo.RealName)
+	if tenantName == "鐨勫伐浣滅┖闂? {
+		// 濡傛灉鐪熷疄濮撳悕涓虹┖锛屼娇鐢ㄧ櫥褰曞悕
+		tenantName = fmt.Sprintf("%s鐨勫伐浣滅┖闂?, casUserInfo.LoginName)
+	}
+	if tenantName == "鐨勫伐浣滅┖闂? {
+		// 濡傛灉鐧诲綍鍚嶄篃涓虹┖锛屼娇鐢ㄧ敤鎴峰悕
+		tenantName = fmt.Sprintf("%s鐨勫伐浣滅┖闂?, username)
+	}
+
+	tenant = &types.Tenant{
+		Name:        tenantName,
+		Description: "榛樿宸ヤ綔绌洪棿",
+		Status:      "active",
+		Business:    "default",
+	}
+
+	createdTenant, err = s.tenantService.CreateTenant(ctx, tenant)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create tenant: %w", err)
+	}
+	logger.Infof(ctx, "Created tenant for new user: %d", createdTenant.ID)
+
+	// 2.6 鍒涘缓鐢ㄦ埛瀵硅薄锛堢粦瀹氬埌鍒氬垱寤虹殑绉熸埛锛?+	// 澶勭悊 Email锛氬鏋?CAS Email 涓虹┖锛屼娇鐢?username 鐢熸垚閭鍦板潃
+	userEmail = casUserInfo.Email
+	if userEmail == "" {
+		// Email 涓虹┖鏃讹紝浣跨敤 username 鐢熸垚閭鍦板潃
+		userEmail = fmt.Sprintf("%s@nxin.local", username)
+		logger.Infof(ctx, "CAS Email is empty, using generated email: %s", userEmail)
+	}
+
+	user = &types.User{
+		ID:             uuid.New().String(),
+		Username:       username,
+		Email:          userEmail,
+		PasswordHash:   string(hashedPassword),
+		Avatar:         "",               // 浣跨敤绯荤粺榛樿澶村儚锛堢┖瀛楃涓诧級
+		TenantID:       createdTenant.ID, // 璁剧疆绉熸埛 ID锛岄伩鍏嶅閿害鏉熼敊璇?+		IsActive:       true,
+		CASUserID:      casUserInfo.ID,
+		CASLoginName:   casUserInfo.LoginName,
+		CASRealName:    casUserInfo.RealName,
+		CASMobilePhone: casUserInfo.MobilePhone,
+		CreatedAt:      time.Now(),
+		UpdatedAt:      time.Now(),
+	}
+
+	// 2.7 淇濆瓨鐢ㄦ埛鍒版暟鎹簱
+	if err := s.userRepo.CreateUser(ctx, user); err != nil {
+		// 澶勭悊鍞竴绾︽潫鍐茬獊锛堝苟鍙戝垱寤猴級
+		if strings.Contains(err.Error(), "duplicate key") || strings.Contains(err.Error(), "UNIQUE constraint") {
+			// 閲嶆柊鏌ユ壘鐢ㄦ埛锛堟寜浼樺厛绾э細cas_user_id 鈫?email锛?+			if casUserInfo.ID != "" {
+				user, err = s.userRepo.GetUserByCASUserID(ctx, casUserInfo.ID)
+			}
+			if user == nil && userEmail != "" {
+				user, err = s.userRepo.GetUserByEmail(ctx, userEmail)
+			}
+			if user != nil {
+				logger.Warnf(ctx, "Concurrent user creation detected, returning existing user: %s", user.ID)
+				// 骞跺彂鍒涘缓鏃讹紝鐢ㄦ埛宸插瓨鍦紝涓嶉渶瑕佸垹闄ょ鎴凤紙鍙兘鍏朵粬璇锋眰宸茬粦瀹氾級
+				return user, nil
+			}
+		}
+
+		// 鍒涘缓鐢ㄦ埛澶辫触锛屽垹闄や箣鍓嶅垱寤虹殑绉熸埛锛堥伩鍏嶉仐鐣欐湭浣跨敤鐨勭鎴凤級
+		// 娉ㄦ剰锛氬垹闄ょ鎴峰け璐ヤ笉褰卞搷閿欒杩斿洖锛屼絾浼氳褰曟棩蹇?+		if createdTenant != nil && createdTenant.ID > 0 {
+			if deleteErr := s.tenantService.DeleteTenant(ctx, createdTenant.ID); deleteErr != nil {
+				logger.Errorf(ctx, "Failed to delete tenant %d after user creation failed: %v", createdTenant.ID, deleteErr)
+				// 涓嶈繑鍥為敊璇紝鍥犱负涓昏閿欒鏄敤鎴峰垱寤哄け璐?+			} else {
+				logger.Infof(ctx, "Deleted tenant %d after user creation failed", createdTenant.ID)
+			}
+		}
+
+		return nil, fmt.Errorf("failed to create user: %w", err)
+	}
+
+	logger.Infof(ctx, "Created new user: %s (CAS ID: %s)", user.ID, casUserInfo.ID)
+	return user, nil
+
+updateUser:
+	// 姝ラ3锛氱敤鎴峰凡瀛樺湪锛屾洿鏂?CAS 鐩稿叧瀛楁
+	logger.Infof(ctx, "Updating existing user: %s", user.ID)
+
+	// 3.1 鏇存柊 CAS 鐩稿叧瀛楁锛堝鏋滀负绌烘垨闇€瑕佹洿鏂帮級
+	needUpdate := false
+	if user.CASUserID == "" && casUserInfo.ID != "" {
+		user.CASUserID = casUserInfo.ID
+		needUpdate = true
+	}
+	if user.CASLoginName == "" && casUserInfo.LoginName != "" {
+		user.CASLoginName = casUserInfo.LoginName
+		needUpdate = true
+	}
+	if user.CASRealName != casUserInfo.RealName {
+		user.CASRealName = casUserInfo.RealName
+		needUpdate = true
+	}
+	if user.CASMobilePhone != casUserInfo.MobilePhone {
+		user.CASMobilePhone = casUserInfo.MobilePhone
+		needUpdate = true
+	}
+
+	// 3.2 纭繚鐢ㄦ埛鏄縺娲荤姸鎬?+	if !user.IsActive {
+		user.IsActive = true
+		needUpdate = true
+	}
+
+	// 3.3 濡傛灉鏈夋洿鏂帮紝淇濆瓨鍒版暟鎹簱
+	if needUpdate {
+		user.UpdatedAt = time.Now()
+		if err := s.userRepo.UpdateUser(ctx, user); err != nil {
+			logger.Errorf(ctx, "Failed to update user: %v", err)
+			// 涓嶅奖鍝嶄富娴佺▼锛岀户缁繑鍥炵敤鎴?+		} else {
+			logger.Infof(ctx, "Updated user CAS fields: %s", user.ID)
+		}
+	}
+
+	return user, nil
+}
+
+// AutoBindTenant 鑷姩缁戝畾鎴栧垱寤虹鎴凤紙CAS 骞冲彴绉熸埛 鈫?WeKnora 绉熸埛锛?+func (s *casAuthService) AutoBindTenant(ctx context.Context, casUserInfo *types.CASUserInfo, user *types.User) (*types.Tenant, error) {
+	// 姝ラ1锛氭鏌ョ敤鎴锋槸鍚﹀凡鏈夌鎴?+	if user.TenantID > 0 {
+		// 鐢ㄦ埛宸叉湁绉熸埛锛屾煡璇㈠苟杩斿洖
+		tenant, err := s.tenantService.GetTenantByID(ctx, user.TenantID)
+		if err != nil {
+			logger.Errorf(ctx, "Failed to get tenant by ID: %d, error: %v", user.TenantID, err)
+			// 绉熸埛涓嶅瓨鍦ㄦ垨鏌ヨ澶辫触锛岄渶瑕佸垱寤烘柊绉熸埛
+		} else if tenant != nil {
+			logger.Infof(ctx, "User already has tenant: %d", user.TenantID)
+			return tenant, nil
+		}
+		// 濡傛灉绉熸埛涓嶅瓨鍦紝缁х画鍒涘缓鏂扮鎴?+	}
+
+	// 姝ラ2锛氱敤鎴锋病鏈夌鎴锋垨绉熸埛涓嶅瓨鍦紝鍒涘缓鏂扮鎴?+	logger.Infof(ctx, "Creating new tenant for user: %s", user.ID)
+
+	// 2.1 鐢熸垚绉熸埛鍚嶇О
+	tenantName := fmt.Sprintf("%s鐨勫伐浣滅┖闂?, casUserInfo.RealName)
+	if tenantName == "鐨勫伐浣滅┖闂? {
+		// 濡傛灉鐪熷疄濮撳悕涓虹┖锛屼娇鐢ㄧ櫥褰曞悕
+		tenantName = fmt.Sprintf("%s鐨勫伐浣滅┖闂?, casUserInfo.LoginName)
+	}
+	if tenantName == "鐨勫伐浣滅┖闂? {
+		// 濡傛灉鐧诲綍鍚嶄篃涓虹┖锛屼娇鐢ㄧ敤鎴峰悕
+		tenantName = fmt.Sprintf("%s鐨勫伐浣滅┖闂?, user.Username)
+	}
+
+	// 2.2 鍒涘缓绉熸埛瀵硅薄
+	tenant := &types.Tenant{
+		Name:        tenantName,
+		Description: "榛樿宸ヤ綔绌洪棿",
+		Status:      "active",
+		Business:    "default",
+	}
+
+	// 2.3 鍒涘缓绉熸埛锛堜細鑷姩鐢熸垚 API Key 鍜岃缃粯璁ら厤缃級
+	createdTenant, err := s.tenantService.CreateTenant(ctx, tenant)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create tenant: %w", err)
+	}
+
+	// 姝ラ3锛氬皢鐢ㄦ埛缁戝畾鍒扮鎴?+	user.TenantID = createdTenant.ID
+	user.UpdatedAt = time.Now()
+	if err := s.userRepo.UpdateUser(ctx, user); err != nil {
+		logger.Errorf(ctx, "Failed to bind user to tenant: %v", err)
+		// 缁戝畾澶辫触锛屽垹闄ゅ垰鍒涘缓鐨勭鎴凤紙閬垮厤閬楃暀鏈娇鐢ㄧ殑绉熸埛锛?+		if deleteErr := s.tenantService.DeleteTenant(ctx, createdTenant.ID); deleteErr != nil {
+			logger.Errorf(ctx, "Failed to delete tenant %d after user binding failed: %v", createdTenant.ID, deleteErr)
+			// 涓嶈繑鍥為敊璇紝鍥犱负涓昏閿欒鏄敤鎴风粦瀹氬け璐?+		} else {
+			logger.Infof(ctx, "Deleted tenant %d after user binding failed", createdTenant.ID)
+		}
+		return nil, fmt.Errorf("failed to bind user to tenant: %w", err)
+	}
+
+	logger.Infof(ctx, "Bound user %s to tenant %d", user.ID, createdTenant.ID)
+	return createdTenant, nil
+}
