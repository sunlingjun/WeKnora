+// ListSharedKnowledgeBases 鍒楀嚭鍏变韩鐭ヨ瘑搴撳箍鍦猴紙鏀寔鎼滅储銆佸垎椤碉級
+func (s *sharedKnowledgeBaseService) ListSharedKnowledgeBases(ctx context.Context, keyword string, page, pageSize int) ([]*types.KnowledgeBase, int64, error) {
+	// 鏌ヨ鎵€鏈夌煡璇嗗簱锛堝悗缁彲浠ヤ紭鍖栦负鐩存帴鏌ヨ鍏变韩鐭ヨ瘑搴擄級
+	allKBs, err := s.kbRepo.ListKnowledgeBases(ctx)
+	if err != nil {
+		return nil, 0, err
+	}
+
+	// 杩囨护鍏变韩鐭ヨ瘑搴?+	var sharedKBs []*types.KnowledgeBase
+	for _, kb := range allKBs {
+		if kb.Visibility == types.KnowledgeBaseVisibilityShared {
+			// 鍏抽敭璇嶆悳绱?+			if keyword == "" ||
+				containsIgnoreCase(kb.Name, keyword) ||
+				containsIgnoreCase(kb.Description, keyword) {
+				sharedKBs = append(sharedKBs, kb)
+			}
+		}
+	}
+
+	// 鍒嗛〉澶勭悊
+	total := int64(len(sharedKBs))
+	start := (page - 1) * pageSize
+	end := start + pageSize
+	if start >= len(sharedKBs) {
+		return []*types.KnowledgeBase{}, total, nil
+	}
+	if end > len(sharedKBs) {
+		end = len(sharedKBs)
+	}
+
+	return sharedKBs[start:end], total, nil
+}
+
+// JoinSharedKnowledgeBase 鍔犲叆鍏变韩鐭ヨ瘑搴?+func (s *sharedKnowledgeBaseService) JoinSharedKnowledgeBase(ctx context.Context, kbID string) error {
+	userID := ctx.Value(types.UserIDContextKey).(string)
+	tenantID := ctx.Value(types.TenantIDContextKey).(uint64)
+
+	// 妫€鏌ョ煡璇嗗簱鏄惁瀛樺湪涓斾负鍏变韩鐭ヨ瘑搴?+	kb, err := s.kbRepo.GetKnowledgeBaseByID(ctx, kbID)
+	if err != nil {
+		return fmt.Errorf("knowledge base not found: %w", err)
+	}
+	if kb.Visibility != types.KnowledgeBaseVisibilityShared {
+		return errors.New("knowledge base is not shared")
+	}
+
+	// 妫€鏌ユ槸鍚﹀凡缁忔槸鎴愬憳
+	existingMember, err := s.memberRepo.GetMemberByKBAndUser(ctx, kbID, userID)
+	if err == nil && existingMember != nil {
+		return errors.New("already a member of this knowledge base")
+	}
+
+	// 鍒涘缓鎴愬憳璁板綍
+	member := &types.KnowledgeBaseMember{
+		ID:              uuid.New().String(),
+		KnowledgeBaseID: kbID,
+		UserID:          userID,
+		TenantID:        tenantID,
+		Role:            types.KBMemberRoleViewer, // 榛樿瑙掕壊涓?viewer
+		JoinedAt:        time.Now(),
+		CreatedAt:       time.Now(),
+		UpdatedAt:       time.Now(),
+	}
+
+	if err := s.memberRepo.CreateMember(ctx, member); err != nil {
+		return fmt.Errorf("failed to join knowledge base: %w", err)
+	}
+
+	// 鏇存柊鎴愬憳鏁伴噺
+	count, err := s.memberRepo.CountMembersByKB(ctx, kbID)
+	if err == nil {
+		kb.MemberCount = int(count)
+		s.kbRepo.UpdateKnowledgeBase(ctx, kb)
+	}
+
+	logger.Infof(ctx, "User %s joined shared knowledge base %s", userID, kbID)
+	return nil
+}
+
+// LeaveSharedKnowledgeBase 绂诲紑鍏变韩鐭ヨ瘑搴?+func (s *sharedKnowledgeBaseService) LeaveSharedKnowledgeBase(ctx context.Context, kbID string) error {
+	userID := ctx.Value(types.UserIDContextKey).(string)
+
+	// 妫€鏌ョ煡璇嗗簱鏄惁瀛樺湪涓斾负鍏变韩鐭ヨ瘑搴?+	kb, err := s.kbRepo.GetKnowledgeBaseByID(ctx, kbID)
+	if err != nil {
+		return fmt.Errorf("knowledge base not found: %w", err)
+	}
+	if kb.Visibility != types.KnowledgeBaseVisibilityShared {
+		return errors.New("knowledge base is not shared")
+	}
+
+	// 妫€鏌ユ槸鍚︽槸鍒涘缓鑰咃紙鍒涘缓鑰呬笉鑳界寮€锛?+	if kb.OwnerID == userID {
+		return errors.New("owner cannot leave the knowledge base")
+	}
+
+	// 妫€鏌ユ槸鍚︽槸鎴愬憳
+	member, err := s.memberRepo.GetMemberByKBAndUser(ctx, kbID, userID)
+	if err != nil {
+		return fmt.Errorf("not a member of this knowledge base: %w", err)
+	}
+
+	// 鍙岄噸妫€鏌ワ細濡傛灉鎴愬憳瑙掕壊鏄?owner锛屼篃涓嶈兘绂诲紑
+	if member.Role == types.KBMemberRoleOwner {
+		return errors.New("owner cannot leave the knowledge base")
+	}
+
+	// 鍒犻櫎鎴愬憳璁板綍
+	if err := s.memberRepo.DeleteMember(ctx, kbID, userID); err != nil {
+		return fmt.Errorf("failed to leave knowledge base: %w", err)
+	}
+
+	// 鏇存柊鎴愬憳鏁伴噺
+	kb, err = s.kbRepo.GetKnowledgeBaseByID(ctx, kbID)
+	if err == nil {
+		count, err := s.memberRepo.CountMembersByKB(ctx, kbID)
+		if err == nil {
+			kb.MemberCount = int(count)
+			s.kbRepo.UpdateKnowledgeBase(ctx, kb)
+		}
+	}
+
+	logger.Infof(ctx, "User %s left shared knowledge base %s", userID, kbID)
+	return nil
+}
+
+// ListKnowledgeBaseMembers 鍒楀嚭鐭ヨ瘑搴撴垚鍛?+func (s *sharedKnowledgeBaseService) ListKnowledgeBaseMembers(ctx context.Context, kbID string, keyword string, page, pageSize int) ([]*types.KnowledgeBaseMember, int64, error) {
+	return s.memberRepo.ListMembersByKB(ctx, kbID, keyword, page, pageSize)
+}
+
+// UpdateMemberRole 鏇存柊鎴愬憳鏉冮檺锛堜粎鍒涘缓鑰呭彲鎿嶄綔锛?+func (s *sharedKnowledgeBaseService) UpdateMemberRole(ctx context.Context, kbID string, userID string, role string) error {
+	// 楠岃瘉瑙掕壊
+	if role != types.KBMemberRoleViewer && role != types.KBMemberRoleEditor {
+		return errors.New("invalid role")
+	}
+
+	// 妫€鏌ュ綋鍓嶇敤鎴锋槸鍚︽槸鍒涘缓鑰?+	currentUserID := ctx.Value(types.UserIDContextKey).(string)
+	kb, err := s.kbRepo.GetKnowledgeBaseByID(ctx, kbID)
+	if err != nil {
+		return fmt.Errorf("knowledge base not found: %w", err)
+	}
+	if kb.OwnerID != currentUserID {
+		return errors.New("only owner can update member role")
+	}
+
+	// 涓嶈兘淇敼鍒涘缓鑰呯殑瑙掕壊
+	if userID == kb.OwnerID {
+		return errors.New("cannot update owner role")
+	}
+
+	// 鏇存柊鎴愬憳瑙掕壊
+	return s.memberRepo.UpdateMemberRole(ctx, kbID, userID, role)
+}
+
+// RemoveMember 绉婚櫎鎴愬憳锛堜粎鍒涘缓鑰呭彲鎿嶄綔锛?+func (s *sharedKnowledgeBaseService) RemoveMember(ctx context.Context, kbID string, userID string) error {
+	// 妫€鏌ュ綋鍓嶇敤鎴锋槸鍚︽槸鍒涘缓鑰?+	currentUserID := ctx.Value(types.UserIDContextKey).(string)
+	kb, err := s.kbRepo.GetKnowledgeBaseByID(ctx, kbID)
+	if err != nil {
+		return fmt.Errorf("knowledge base not found: %w", err)
+	}
+	if kb.OwnerID != currentUserID {
+		return errors.New("only owner can remove members")
+	}
+
+	// 涓嶈兘绉婚櫎鍒涘缓鑰?+	if userID == kb.OwnerID {
+		return errors.New("cannot remove owner")
+	}
+
+	// 鍒犻櫎鎴愬憳
+	if err := s.memberRepo.DeleteMember(ctx, kbID, userID); err != nil {
+		return fmt.Errorf("failed to remove member: %w", err)
+	}
+
+	// 鏇存柊鎴愬憳鏁伴噺
+	count, err := s.memberRepo.CountMembersByKB(ctx, kbID)
+	if err == nil {
+		kb.MemberCount = int(count)
+		s.kbRepo.UpdateKnowledgeBase(ctx, kb)
+	}
+
+	logger.Infof(ctx, "Removed member %s from knowledge base %s", userID, kbID)
+	return nil
+}
+
+// CheckMemberPermission 妫€鏌ユ垚鍛樻潈闄?+func (s *sharedKnowledgeBaseService) CheckMemberPermission(ctx context.Context, kbID string, permission string) (bool, error) {
+	userID := ctx.Value(types.UserIDContextKey).(string)
+
+	// 鑾峰彇鐭ヨ瘑搴撲俊鎭?+	kb, err := s.kbRepo.GetKnowledgeBaseByID(ctx, kbID)
+	if err != nil {
+		return false, fmt.Errorf("knowledge base not found: %w", err)
+	}
+
+	// 濡傛灉鏄釜浜虹煡璇嗗簱锛屾鏌ユ槸鍚︽槸鍒涘缓鑰?+	if kb.Visibility == types.KnowledgeBaseVisibilityPrivate {
+		return kb.OwnerID == userID, nil
+	}
+
+	// 濡傛灉鏄叡浜煡璇嗗簱锛屾鏌ユ垚鍛樻潈闄?+	member, err := s.memberRepo.GetMemberByKBAndUser(ctx, kbID, userID)
+	if err != nil {
+		return false, nil // 涓嶆槸鎴愬憳锛屾棤鏉冮檺
+	}
+
+	switch permission {
+	case "read":
+		return member != nil, nil
+	case "write":
+		return member != nil && (member.Role == types.KBMemberRoleOwner || member.Role == types.KBMemberRoleEditor), nil
+	case "delete":
+		return member != nil && member.Role == types.KBMemberRoleOwner, nil
+	default:
+		return false, errors.New("invalid permission")
+	}
+}
+
+// ListUserKnowledgeBases 鍒楀嚭鐢ㄦ埛鐨勭煡璇嗗簱锛堜釜浜?+ 鍒涘缓鐨勫叡浜煡璇嗗簱 + 鍔犲叆鐨勫叡浜煡璇嗗簱锛?+func (s *sharedKnowledgeBaseService) ListUserKnowledgeBases(ctx context.Context, includeShared bool) ([]*types.KnowledgeBase, error) {
+	userID := ctx.Value(types.UserIDContextKey).(string)
+	tenantID := ctx.Value(types.TenantIDContextKey).(uint64)
+
+	var result []*types.KnowledgeBase
+	kbIDMap := make(map[string]bool) // 鐢ㄤ簬鍘婚噸锛堢煡璇嗗簱ID -> 鏄惁宸叉坊鍔狅級
+
+	// 1. 鏌ヨ涓汉鐭ヨ瘑搴擄紙visibility = 'private' AND owner_id = 褰撳墠鐢ㄦ埛ID锛?+	personalKBs, err := s.kbRepo.ListKnowledgeBasesByTenantID(ctx, tenantID)
+	if err != nil {
+		return nil, err
+	}
+	for _, kb := range personalKBs {
+		if kb.Visibility == types.KnowledgeBaseVisibilityPrivate && kb.OwnerID == userID {
+			result = append(result, kb)
+			kbIDMap[kb.ID] = true
+		}
+	}
+
+	// 2. 鏌ヨ鍏变韩鐭ヨ瘑搴擄紙鍖呮嫭鍒涘缓鐨?+ 鍔犲叆鐨勶級
+	if includeShared {
+		// 2.1 鏌ヨ鐢ㄦ埛鍒涘缓鐨勫叡浜煡璇嗗簱锛堥€氳繃 owner_id锛?+		allKBs, err := s.kbRepo.ListKnowledgeBasesByTenantID(ctx, tenantID)
+		if err != nil {
+			return nil, err
+		}
+		for _, kb := range allKBs {
+			if kb.Visibility == types.KnowledgeBaseVisibilityShared && kb.OwnerID == userID {
+				// 閬垮厤閲嶅娣诲姞
+				if !kbIDMap[kb.ID] {
+					result = append(result, kb)
+					kbIDMap[kb.ID] = true
+				}
+			}
+		}
+
+		// 2.2 鏌ヨ鐢ㄦ埛鍔犲叆鐨勫叡浜煡璇嗗簱锛堥€氳繃鎴愬憳琛紝涓嶅寘鎷嚜宸卞垱寤虹殑锛?+		members, err := s.memberRepo.ListMembersByUser(ctx, userID)
+		if err != nil {
+			return nil, err
+		}
+
+		// 鎵归噺鏌ヨ鐭ヨ瘑搴擄紙閬垮厤澶氭鍗曠嫭鏌ヨ锛?+		kbIDs := make([]string, 0)
+		for _, member := range members {
+			// 鍙煡璇笉鏄嚜宸卞垱寤虹殑鐭ヨ瘑搴擄紙閬垮厤閲嶅锛?+			if !kbIDMap[member.KnowledgeBaseID] {
+				kbIDs = append(kbIDs, member.KnowledgeBaseID)
+			}
+		}
+
+		if len(kbIDs) > 0 {
+			sharedKBs, err := s.kbRepo.GetKnowledgeBaseByIDs(ctx, kbIDs)
+			if err == nil {
+				for _, kb := range sharedKBs {
+					if kb.Visibility == types.KnowledgeBaseVisibilityShared {
+						result = append(result, kb)
+						kbIDMap[kb.ID] = true
+					}
+				}
+			}
+		}
+	}
+
+	return result, nil
+}
+
+// GetMemberRoleByKBAndUser 鑾峰彇鐢ㄦ埛鍦ㄦ寚瀹氱煡璇嗗簱涓殑瑙掕壊
+func (s *sharedKnowledgeBaseService) GetMemberRoleByKBAndUser(ctx context.Context, kbID string, userID string) (string, error) {
+	member, err := s.memberRepo.GetMemberByKBAndUser(ctx, kbID, userID)
+	if err != nil {
+		// 鎴愬憳涓嶅瓨鍦紝妫€鏌ユ槸鍚︿负鍒涘缓鑰?+		kb, err := s.kbRepo.GetKnowledgeBaseByID(ctx, kbID)
+		if err != nil {
+			return "", err
+		}
+		if kb.OwnerID == userID {
+			return types.KBMemberRoleOwner, nil
+		}
+		return "", nil // 涓嶆槸鎴愬憳涔熶笉鏄垱寤鸿€?+	}
+	return member.Role, nil
+}
+
+// containsIgnoreCase 妫€鏌ュ瓧绗︿覆鏄惁鍖呭惈瀛愬瓧绗︿覆锛堝拷鐣ュぇ灏忓啓锛?+func containsIgnoreCase(s, substr string) bool {
+	return len(s) >= len(substr) &&
+		(strings.Contains(strings.ToLower(s), strings.ToLower(substr)))
+}
