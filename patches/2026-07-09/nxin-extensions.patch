+// CreateSharedKnowledgeBase 鍒涘缓鍏变韩鐭ヨ瘑搴?+func (s *sharedKnowledgeBaseService) CreateSharedKnowledgeBase(ctx context.Context, kb *types.KnowledgeBase) (*types.KnowledgeBase, error) {
