new file mode 100644
index 00000000..5cd55416
--- /dev/null
+++ b/internal/handler/cas_auth.go
@@ -0,0 +1,157 @@
+package handler
+
+import (
+	"fmt"
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+
+	"github.com/Tencent/WeKnora/internal/config"
+	"github.com/Tencent/WeKnora/internal/errors"
+	"github.com/Tencent/WeKnora/internal/logger"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+// CASAuthHandler CAS 璁よ瘉 Handler
+type CASAuthHandler struct {
+	casAuthService interfaces.CASAuthService
+	userService    interfaces.UserService
+	tenantService  interfaces.TenantService
+	config         *config.Config
+}
+
+// NewCASAuthHandler 鍒涘缓 CAS 璁よ瘉 Handler
+func NewCASAuthHandler(
+	casAuthService interfaces.CASAuthService,
+	userService interfaces.UserService,
+	tenantService interfaces.TenantService,
+	cfg *config.Config,
+) *CASAuthHandler {
+	return &CASAuthHandler{
+		casAuthService: casAuthService,
+		userService:    userService,
+		tenantService:  tenantService,
+		config:         cfg,
+	}
+}
+
+// ValidateCASSession 楠岃瘉 CAS 浼氳瘽
+// @Summary      楠岃瘉 CAS 浼氳瘽
+// @Description  閫氳繃 Cookie 涓殑 _cas_sid 鍜?_cas_uid 楠岃瘉 CAS 鐧诲綍鐘舵€?+// @Tags         CAS璁よ瘉
+// @Accept       json
+// @Produce      json
+// @Success      200      {object}  map[string]interface{}  "楠岃瘉鎴愬姛锛岃繑鍥炵敤鎴峰拰绉熸埛淇℃伅"
+// @Failure      401      {object}  errors.AppError  "鏈櫥褰曟垨浼氳瘽杩囨湡"
+// @Router       /api/v1/cas/validate [get]
+func (h *CASAuthHandler) ValidateCASSession(c *gin.Context) {
+	ctx := c.Request.Context()
+
+	// 1. 浠庨厤缃幏鍙栧綋鍓嶇幆澧冪殑 Cookie 鍚嶇О
+	if h.config == nil || h.config.CAS == nil {
+		logger.Errorf(ctx, "CAS config is not initialized")
+		c.Error(errors.NewInternalServerError("CAS 閰嶇疆鏈垵濮嬪寲"))
+		return
+	}
+	casConfig := h.config.CAS.GetCurrentConfig()
+	if casConfig == nil {
+		logger.Errorf(ctx, "CAS environment config is not available")
+		c.Error(errors.NewInternalServerError("CAS 鐜閰嶇疆涓嶅彲鐢?))
+		return
+	}
+	cookieSID := casConfig.CookieSID
+	cookieUID := casConfig.CookieUID
+
+	// 2. 浠?Cookie 鑾峰彇 CAS 浼氳瘽淇℃伅锛堟牴鎹幆澧冭鍙栧搴旂殑 Cookie锛?+	casSid, err := c.Cookie(cookieSID)
+	if err != nil {
+		casSid = ""
+	}
+	casUid, err := c.Cookie(cookieUID)
+	if err != nil {
+		casUid = ""
+	}
+
+	if casSid == "" || casUid == "" {
+		logger.Warn(ctx, "Missing CAS session cookies")
+		c.JSON(http.StatusUnauthorized, gin.H{
+			"code":      10011,
+			"exception": "please to login",
+			"msg":       "鏈幏鍙栧埌鐧诲綍淇℃伅",
+		})
+		return
+	}
+
+	// 3. 鑾峰彇 Referer 澶达紙CAS API 闇€瑕佹澶磋繘琛屾牎楠岋級
+	referer := c.GetHeader("Referer")
+	if referer == "" {
+		// 濡傛灉娌℃湁 Referer锛屽皾璇曚粠 Origin 鏋勫缓
+		origin := c.GetHeader("Origin")
+		if origin != "" {
+			referer = origin + "/"
+		} else {
+			// 浣跨敤閰嶇疆涓殑鐧诲綍椤甸潰鍦板潃浣滀负榛樿 Referer
+			referer = fmt.Sprintf("https://%s/", casConfig.LoginHost)
+		}
+	}
+	logger.Debugf(ctx, "Using Referer: %s", referer)
+
+	// 4. 楠岃瘉 CAS 浼氳瘽锛堣皟鐢?CAS 鎺ュ彛锛?+	casUserInfo, err := h.casAuthService.ValidateCASSession(ctx, casSid, casUid, referer)
+	if err != nil {
+		logger.Errorf(ctx, "Failed to validate CAS session: %v", err)
+		c.JSON(http.StatusUnauthorized, gin.H{
+			"code":      10011,
+			"exception": "please to login",
+			"msg":       "CAS 浼氳瘽楠岃瘉澶辫触",
+		})
+		return
+	}
+
