+    prefixIcon: {default: 'prefixIcon', green: 'prefixIcon', grey: 'prefixIcon'},
+}
+
+export function getIcon(name: IconName, variant: IconVariant = 'default'): IconDef | undefined {
+    const resolvedName = variantAlias[name]?.[variant] ?? name
+    return icons[resolvedName]
+}
+
+export function hasIcon(name: string): name is IconName {
+    return name in icons
+}
