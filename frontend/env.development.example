# 开发 / 测试域模板（vite --mode development）
# 复制为 frontend/.env.development 后按本机调整；勿提交含密钥的本地覆盖。
VITE_APP_ENV=development
# true：API 走同源 /api（本地 vite proxy 或 nginx 反代）
VITE_IS_DOCKER=true
VITE_DEV_PROXY_TARGET=https://127.0.0.1:8080

VITE_APP_TITLE=农信知识库
VITE_APP_NAME=WeKnora-Nxin
VITE_BUILD_COMPRESS=gzip

VITE_APP_APP=https://zsk.t.nxin.com
VITE_APP_BASE_API=https://zsk.t.nxin.com
VITE_APP_SYSTEM_ID=103
VITE_APP_WO=https://wo.t.nxin.com/
VITE_APP_CAS=https://cas.t.nxin.com/
VITE_APP_OPEN=https://open.t.nxin.com/api/
VITE_APP_FILES=https://files.t.nxin.com/
