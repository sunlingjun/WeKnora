# 生产域模板（vite build --mode production）
# 复制为 frontend/.env.production；部署机用真实域名，勿带 :8080。
VITE_APP_ENV=production
VITE_IS_DOCKER=false

VITE_APP_TITLE=农信知识库
VITE_APP_NAME=WeKnora-Nxin
VITE_BUILD_COMPRESS=gzip

VITE_APP_APP=https://zsk.nxin.com
VITE_APP_BASE_API=https://zsk.nxin.com
VITE_APP_SYSTEM_ID=103
VITE_APP_WO=https://wo.nxin.com/
VITE_APP_CAS=https://cas.nxin.com/
VITE_APP_OPEN=https://open.nxin.com/api/
VITE_APP_FILES=https://files.nxin.com/
